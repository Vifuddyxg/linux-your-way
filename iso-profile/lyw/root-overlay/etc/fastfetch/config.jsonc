// Linux Your Way — system-wide fastfetch config: letter-art Tux-with-hardhat
// logo, converted from branding/linuxyw.jpeg with scripts/img2ansi.py
// (truecolor ANSI). neofetch: neofetch --source /usr/share/lyw/logo.txt
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "/usr/share/lyw/logo.txt",
        "padding": { "right": 3 }
    }
}
